{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (or Run) Main",
            "type": "cppdbg",
            "request": "launch",
            // change executable's filename if the original file's executable changed (from-'main'):
            "program": "${workspaceFolder}/main", // => 
            // points to the actual executable name from the Makefile.
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false, // where the debugger runs:
            // 'false': directly in the terminal, 'true': spawns a new terminal window.
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Make Build", 
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
